<Project>

    <!-- Settings shared by every project; not repeated in each csproj. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Namespaces stay rooted at SqlMetadataGenerator even when the folders move. -->
        <RootNamespace>SqlMetadataGenerator</RootNamespace>
    </PropertyGroup>

</Project>
