<Project Sdk="Microsoft.NET.Sdk">

    <!-- Metadata reading, script generation and deploy logic. Shared by Cli and Web;
         it must carry no console- or web-specific dependency. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <!-- Pinned above SqlClient's transitive 9.0.x, which has NU1902/NU1903
             advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Drop once
             SqlClient itself depends on a patched version. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

</Project>
